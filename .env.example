# ── LLM Anthropic ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Optionnel — coûts réels via l'API Admin (l'estimation par tokens sert de repli).
ANTHROPIC_ADMIN_KEY=

# ── Sécurité de l'instance (obligatoire dès qu'elle quitte un poste isolé) ─────
# Clé de chiffrement des mots de passe de connexion stockés en base.
# Vide → une clé est créée dans `data/.secret_key`. Sur un serveur partagé, RENSEIGNEZ-LA :
# une clé rangée à côté de la base ne protège que les copies de la base.
# Générer : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TESTPILOT_SECRET_KEY=

# Mot de passe d'instance (verrou d'accès partagé par l'équipe).
# Vide → AUCUN verrou : quiconque atteint le port pilote des tests contre l'application cible et
# lit les rapports. Acceptable sur un poste isolé, jamais sur un réseau.
# Ce n'est pas un système de comptes — un seul secret, plus un nom déclaré par chacun.
TESTPILOT_ACCESS_PASSWORD=
TESTPILOT_SESSION_DAYS=30

# ── Connecteur Odoo — repli GLOBAL, pour la ligne de commande uniquement ───────
# ⚠️ Depuis le 2026-07-24, l'interface n'utilise PLUS ces valeurs : chaque projet porte sa propre
# connexion, et un projet incomplet fait REFUSER le lancement au lieu de retomber ici en silence
# (un run pouvait réussir contre une autre application que celle affichée). Elles ne servent plus
# qu'à la CLI et aux scripts de mesure.
ODOO_URL=http://localhost:10017
ODOO_DB=odoo_test
ODOO_USER=admin
ODOO_PASSWORD=admin
# ODOO_ENV=prod   # NE JAMAIS activer : une garde de sécurité bloque toute exécution

# ── Modèles et coûts (§9 du brief : moins de 1 € par cas) ─────────────────────
# Revenu à Sonnet 4.6 le 2026-07-23 sur mesure réelle (Sonnet 5 : qualité en baisse et coût ×2 sur
# notre prompt). Rebasculer suppose de re-mesurer, pas de supposer.
# TESTPILOT_MODEL_GENERATION=claude-sonnet-4-6
TESTPILOT_COST_SOURCE=estimated

# ⚠️ `TESTPILOT_MONTHLY_BUDGET_EUR` a disparu de ce fichier : le plafond mensuel de 50 € a été
# retiré du périmètre produit le 2026-07-17 (c'était le budget de développement du porteur, pas
# une limite applicative). La seule cible de coût est celle du §9 : moins de 1 € par cas.

# ── Emplacements (optionnels) ─────────────────────────────────────────────────
# TESTPILOT_DATA_DIR=/var/lib/testpilot
# TESTPILOT_DB_PATH=/var/lib/testpilot/testpilot.db
