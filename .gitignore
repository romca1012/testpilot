# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
build/
dist/

# Secrets
.env
# Clé de chiffrement des secrets de connexion (2026-07-24). Déjà couverte par `/data/*`, répétée
# ici parce qu'un TESTPILOT_DATA_DIR pointant ailleurs la sortirait de cette règle — et une clé
# commitée annulerait tout l'intérêt du chiffrement.
.secret_key

# Persistance légère & artefacts générés (source de vérité = SQLite + historisation)
/data/*
!/data/.gitkeep
# ⚠️ EXCEPTION : le modèle du domaine EST du code source, pas un artefact (décision 0021).
# Produit par `scripts/crawl_domaine.py` (crawl déterministe, aucun LLM), il est la RÉFÉRENCE que
# le smoke-check consulte — et sa revue humaine passe par le **diff git** : `git diff
# data/domain/odoo.json` dit exactement quels champs/options/routes l'application a gagnés ou
# perdus. L'ignorer reviendrait à avoir une « source de vérité versionnée » que rien ne versionne,
# et une régression de l'application deviendrait la nouvelle vérité sans que personne la voie.
!/data/domain/
!/data/domain/*.json
/behave_runtime/generated/*
!/behave_runtime/generated/.gitkeep

# Bases SQLite éventuelles hors data/
*.db
*.db-shm
*.db-wal

# Frontend (Vite + Vue) — dépendances et build
/frontend/node_modules/
/frontend/dist/
/frontend/.vite/
